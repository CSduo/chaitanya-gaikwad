# ==============================================================================
# XIYATO Production Environment Contract
# ==============================================================================
#
# Copy this file to .env.local for development and configure in your deployment
# platform (Vercel, Railway, AWS, etc.) for production.
#
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for durable lead persistence, upload metadata, and distributed rate limiting.
# Compatible with Neon, Supabase, AWS RDS, Railway, or standard PostgreSQL.
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. PRIVATE OBJECT STORAGE CONFIGURATION (S3-Compatible / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Required for durable, private storage of client CAD drawings, 3D files, and briefs.
# Customer uploads are stored as private binaries with cryptographic keys and never publicly enumerated.
#
# Cloudflare R2 Example:
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=xiyato-scoping-vault
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
#
# AWS S3 Example:
# STORAGE_REGION=eu-west-2
# STORAGE_BUCKET=xiyato-scoping-vault
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 3. NOTIFICATION & ENQUIRY DISPATCH (Resend)
# ------------------------------------------------------------------------------
# Required for real-time email notifications of inbound customer briefs.
# If unconfigured, enquiries are still safely persisted in PostgreSQL and not lost.
ENQUIRY_PROVIDER_API_KEY=
ENQUIRY_FROM_EMAIL="XIYATO <contact@xiyato.uk>"
ENQUIRY_TO_EMAIL="contact@xiyato.uk"
ENQUIRY_TO_EMAIL_CAREERS=

# ------------------------------------------------------------------------------
# 4. MAINTENANCE & RETENTION CRON (Fail-Closed)
# ------------------------------------------------------------------------------
# Required for triggering /api/cron/cleanup-uploads.
# Must be set to a cryptographically random string (e.g. openssl rand -hex 32).
# Invocations fail closed (HTTP 500/401) if missing or mismatched.
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. SEARCH DISCOVERY & INDEXNOW (Protected & Domain-Restricted)
# ------------------------------------------------------------------------------
# Required for triggering automated URL discovery on Microsoft Bing / IndexNow engines.
# INDEXNOW_SECRET: Internal bearer token required to call POST /api/indexnow.
# INDEXNOW_KEY: Publicly hosted verification key matching xiyato.uk/<key>.txt.
INDEXNOW_SECRET=
INDEXNOW_KEY=
