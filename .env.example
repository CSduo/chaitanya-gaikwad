# XIYATO — environment contract
#
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production.
#
# Without these, the enquiry form still renders, validates server-side and
# fails honestly with an alternate contact route. It never reports a false
# success. Nothing else on the site depends on environment configuration.

# Resend API key — https://resend.com
ENQUIRY_PROVIDER_API_KEY=

# Verified sender on a domain you control, e.g. "XIYATO <site@xiyato.uk>"
ENQUIRY_FROM_EMAIL=

# Destination inbox for project enquiries
ENQUIRY_TO_EMAIL=

# Optional: separate inbox for talent-network submissions.
# Falls back to ENQUIRY_TO_EMAIL when unset.
ENQUIRY_TO_EMAIL_CAREERS=
